<odoo>
    <record id="view_bel_bonus_type_tree" model="ir.ui.view">
        <field name="name">bel.bonus.type.tree</field>
        <field name="model">bel.bonus.type</field>
        <field name="arch" type="xml">
            <list string="Bonus Types">
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_bel_bonus_type_form" model="ir.ui.view">
        <field name="name">bel.bonus.type.form</field>
        <field name="model">bel.bonus.type</field>
        <field name="arch" type="xml">
            <form string="Bonus Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="category"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_bel_bonus_type" model="ir.actions.act_window">
        <field name="name">Bonus Types</field>
        <field name="res_model">bel.bonus.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>