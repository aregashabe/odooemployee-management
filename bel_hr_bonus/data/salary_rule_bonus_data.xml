<odoo>
    <data noupdate="1">
        <!-- Define a self-contained Bonus Category -->
        <record id="bel_salary_rule_category_bonus" model="hr.salary.rule.category">
            <field name="name">Bonus</field>
            <field name="code">BONUS_CAT</field>
        </record>

        <!-- Bonus Salary Rule -->
        <record id="hr_salary_rule_bonus_input" model="hr.salary.rule">
            <field name="name">Bonus Allowance</field>
            <field name="code">BONUS</field>
            <field name="category_id" ref="bel_salary_rule_category_bonus"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = inputs.BONUS and inputs.BONUS.amount or 0.0</field>
        </record>
    </data>
</odoo>