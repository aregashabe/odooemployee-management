<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_bel_hr_base" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.bel.hr.base</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="BelTech HR Policies" name="bel_hr_base">
                    <block title="Employment Policies">
                        <setting
                            string="Default Probation Period"
                            help="Default probation period for new employees, in months."
                        >
                            <field name="bel_hr_default_probation_months"/>
                        </setting>

                        <setting
                            string="Contract Expiration Reminder"
                            help="Number of days before contract expiry to send a reminder."
                        >
                            <field name="bel_hr_contract_reminder_days"/>
                        </setting>

                        <setting
                            string="Require Contract Approval"
                            help="When enabled, employment contracts must be submitted for approval by an HR manager."
                        >
                            <field name="bel_hr_require_contract_approval"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
