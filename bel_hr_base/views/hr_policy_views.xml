<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================================== -->
    <!-- Employment Categories                 -->
    <!-- ====================================== -->

    <record id="view_bel_hr_employment_category_list"
            model="ir.ui.view">
        <field name="name">bel.hr.employment.category.list</field>
        <field name="model">bel.hr.employment.category</field>
        <field name="arch" type="xml">
            <list string="Employment Categories">
                <field name="name"/>
                <field name="code"/>
                <field name="requires_end_date"/>
                <field name="probation_required"/>
                <field name="company_id"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_bel_hr_employment_category_form"
            model="ir.ui.view">
        <field name="name">bel.hr.employment.category.form</field>
        <field name="model">bel.hr.employment.category</field>
        <field name="arch" type="xml">
            <form string="Employment Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="company_id"/>
                        <field name="requires_end_date"/>
                        <field name="probation_required"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bel_hr_employment_category"
            model="ir.actions.act_window">
        <field name="name">Employment Categories</field>
        <field name="res_model">bel.hr.employment.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ====================================== -->
    <!-- Employee Grades                       -->
    <!-- ====================================== -->

    <record id="view_bel_hr_employee_grade_list"
            model="ir.ui.view">
        <field name="name">bel.hr.employee.grade.list</field>
        <field name="model">bel.hr.employee.grade</field>
        <field name="arch" type="xml">
            <list string="Employee Grades">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="use_salary_band"/>
                <field name="salary_min" optional="hide"/>
                <field name="salary_max" optional="hide"/>
                <field name="company_id"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_bel_hr_employee_grade_form"
            model="ir.ui.view">
        <field name="name">bel.hr.employee.grade.form</field>
        <field name="model">bel.hr.employee.grade</field>
        <field name="arch" type="xml">
            <form string="Employee Grade">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="company_id"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="use_salary_band"/>
                        <field name="currency_id"
                               invisible="not use_salary_band"/>
                        <field name="salary_min"
                               invisible="not use_salary_band"
                               required="use_salary_band"/>
                        <field name="salary_max"
                               invisible="not use_salary_band"
                               required="use_salary_band"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bel_hr_employee_grade"
            model="ir.actions.act_window">
        <field name="name">Employee Grades</field>
        <field name="res_model">bel.hr.employee.grade</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ====================================== -->
    <!-- Navigation Menu                       -->
    <!-- ====================================== -->

    <menuitem id="menu_bel_hr_policy_root"
              name="BelTech HR Policies"
              sequence="80"
              groups="base.group_user"/>

    <menuitem id="menu_bel_hr_employment_category"
              name="Employment Categories"
              parent="menu_bel_hr_policy_root"
              action="action_bel_hr_employment_category"
              sequence="10"
              groups="base.group_user"/>

    <menuitem id="menu_bel_hr_employee_grade"
              name="Employee Grades"
              parent="menu_bel_hr_policy_root"
              action="action_bel_hr_employee_grade"
              sequence="20"
              groups="base.group_user"/>

</odoo>
