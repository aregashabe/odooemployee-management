<odoo>
    <record id="view_bel_bonus_policy_tree" model="ir.ui.view">
        <field name="name">bel.bonus.policy.tree</field>
        <field name="model">bel.bonus.policy</field>
        <field name="arch" type="xml">
            <list string="Bonus Policies">
                <field name="name"/>
                <field name="company_id"/>
                <field name="bonus_type_id"/>
                <field name="calculation_method"/>
                <field name="effective_date"/>
            </list>
        </field>
    </record>

    <record id="view_bel_bonus_policy_form" model="ir.ui.view">
        <field name="name">bel.bonus.policy.form</field>
        <field name="model">bel.bonus.policy</field>
        <field name="arch" type="xml">
            <form string="Bonus Policy">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="bonus_type_id"/>
                        <field name="effective_date"/>
                        <field name="end_date"/>
                    </group>
                    <group string="Calculation &amp; Rules">
                        <field name="calculation_method"/>
                        <field name="fixed_amount" invisible="calculation_method != 'fixed'"/>
                        <field name="percentage_rate" invisible="calculation_method != 'percentage'"/>
                        <field name="min_service_months"/>
                        <field name="min_performance_score"/>
                        <field name="max_bonus_limit"/>
                        <field name="frequency"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_bel_bonus_policy" model="ir.actions.act_window">
        <field name="name">Bonus Policies</field>
        <field name="res_model">bel.bonus.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>