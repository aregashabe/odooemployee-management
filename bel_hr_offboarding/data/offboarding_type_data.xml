<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Offboarding Requests (e.g. OFF/00001) -->
        <record id="seq_hr_offboarding_request" model="ir.sequence">
            <field name="name">Offboarding Request Sequence</field>
            <field name="code">hr.offboarding.request</field>
            <field name="prefix">OFF/</field>
            <field name="padding">5</field>
        </record>

        <!-- Sequence for Final Settlement Statements (e.g. SETT/00001) -->
        <record id="seq_hr_offboarding_settlement" model="ir.sequence">
            <field name="name">Offboarding Settlement Sequence</field>
            <field name="code">hr.offboarding.settlement</field>
            <field name="prefix">SETT/</field>
            <field name="padding">5</field>
        </record>

        <!-- Pre-configured Ethiopian Separation Types -->
        <record id="type_resignation" model="hr.offboarding.type">
            <field name="name">Voluntary Resignation</field>
            <field name="category">resignation</field>
            <field name="notice_period_days">30</field>
            <field name="requires_severance">False</field>
        </record>

        <record id="type_redundancy" model="hr.offboarding.type">
            <field name="name">Redundancy / Layoff</field>
            <field name="category">redundancy</field>
            <field name="notice_period_days">30</field>
            <field name="requires_severance">True</field>
        </record>

        <record id="type_retirement" model="hr.offboarding.type">
            <field name="name">Retirement</field>
            <field name="category">retirement</field>
            <field name="notice_period_days">60</field>
            <field name="requires_severance">False</field>
        </record>

        <record id="type_contract_end" model="hr.offboarding.type">
            <field name="name">End of Fixed-Term Contract</field>
            <field name="category">contract_end</field>
            <field name="notice_period_days">15</field>
            <field name="requires_severance">False</field>
        </record>
    </data>
</odoo>