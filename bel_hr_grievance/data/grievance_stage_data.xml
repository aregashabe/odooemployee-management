<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="stage_draft" model="bel.hr.grievance.stage">
            <field name="name">Draft</field>
            <field name="sequence">10</field>
            <field name="stage_type">draft</field>
        </record>
        <record id="stage_submitted" model="bel.hr.grievance.stage">
            <field name="name">Submitted</field>
            <field name="sequence">20</field>
            <field name="stage_type">submitted</field>
        </record>
        <record id="stage_review" model="bel.hr.grievance.stage">
            <field name="name">Under Review</field>
            <field name="sequence">30</field>
            <field name="stage_type">review</field>
        </record>
        <record id="stage_investigation" model="bel.hr.grievance.stage">
            <field name="name">Investigation</field>
            <field name="sequence">40</field>
            <field name="stage_type">investigation</field>
        </record>
        <record id="stage_proposed" model="bel.hr.grievance.stage">
            <field name="name">Resolution Proposed</field>
            <field name="sequence">50</field>
            <field name="stage_type">proposed</field>
        </record>
        <record id="stage_approved" model="bel.hr.grievance.stage">
            <field name="name">Approved</field>
            <field name="sequence">60</field>
            <field name="stage_type">approved</field>
        </record>
        <record id="stage_closed" model="bel.hr.grievance.stage">
            <field name="name">Closed</field>
            <field name="sequence">70</field>
            <field name="stage_type">closed</field>
            <field name="is_closed">True</field>
        </record>
        <record id="stage_escalated" model="bel.hr.grievance.stage">
            <field name="name">Escalated</field>
            <field name="sequence">80</field>
            <field name="stage_type">escalated</field>
        </record>
        <record id="stage_dismissed" model="bel.hr.grievance.stage">
            <field name="name">Dismissed</field>
            <field name="sequence">90</field>
            <field name="stage_type">dismissed</field>
            <field name="is_closed">True</field>
        </record>
        <record id="stage_reopened" model="bel.hr.grievance.stage">
            <field name="name">Reopened</field>
            <field name="sequence">100</field>
            <field name="stage_type">reopened</field>
        </record>

        <!-- Sequence for Cases -->
        <record id="seq_bel_hr_grievance_case" model="ir.sequence">
            <field name="name">Grievance Case Reference</field>
            <field name="code">bel.hr.grievance.case</field>
            <field name="prefix">GRV/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>