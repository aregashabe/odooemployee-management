<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_grievance" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.grievance</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Grievance Management" string="Grievance Management" name="bel_hr_grievance">
                    <block title="Grievance &amp; Complaint Settings">
                        <setting id="setting_anonymous" help="Allow employees to submit grievances anonymously">
                            <field name="grievance_allow_anonymous"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>